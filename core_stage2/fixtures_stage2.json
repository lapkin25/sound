{
 "format": "sound-stage2-fixtures-1",
 "facts": {
  "g": 9.81,
  "half": 0.5
 },
 "rules": {
  "flight_range": {
   "param": "s",
   "params": [
    "s"
   ],
   "tree": [
    "*",
    "s",
    [
     "*",
     "half",
     [
      "*",
      "s",
      "g"
     ]
    ]
   ],
   "param_types": {
    "s": "Float64"
   },
   "ret": "Float64",
   "inv": [
    ">=",
    "s",
    0.0
   ]
  },
  "hypotenuse": {
   "param": "x",
   "params": [
    "x"
   ],
   "tree": [
    "+",
    [
     "*",
     "x",
     "x"
    ],
    [
     "*",
     "x",
     "x"
    ]
   ],
   "param_types": {
    "x": "Float64"
   },
   "ret": "Float64"
  },
  "right_assoc": {
   "param": "x",
   "params": [
    "x"
   ],
   "tree": [
    "/",
    "x",
    [
     "/",
     2.0,
     4.0
    ]
   ],
   "param_types": {
    "x": "Float64"
   },
   "ret": "Float64"
  },
  "ieee_zero": {
   "param": "a",
   "params": [
    "a"
   ],
   "tree": [
    "/",
    1.0,
    "a"
   ],
   "param_types": {
    "a": "Float64"
   },
   "ret": "Float64"
  },
  "dist": {
   "param": "a",
   "params": [
    "a",
    "b"
   ],
   "tree": [
    "+",
    [
     "*",
     "a",
     "a"
    ],
    [
     "*",
     "b",
     "b"
    ]
   ],
   "param_types": {
    "a": "Float64",
    "b": "Float64"
   },
   "ret": "Float64"
  }
 },
 "spec_source": "spec stage2core;\nfact g = 9.81;\nfact half = 0.5;\npure rule flight_range s = s * half * s * g invariant s >= 0;\npure rule hypotenuse x = x * x + x * x;\npure rule right_assoc x = x / 2.0 / 4.0;\npure rule ieee_zero a = 1.0 / a;\nwire hypotenuse -> flight_range : Float64;\n",
 "spec_source_v02": "spec stage2core;\n\nfact g = 9.81 : Float64;\nfact half = 0.5;\n\nrule flight_range(s: Float64) -> Float64 invariant s >= 0\n     = s * half * s * g;\nrule hypotenuse(x: Float64) -> Float64 = x * x + x * x;\nrule right_assoc(x: Float64) = x / 2.0 / 4.0;\nrule ieee_zero(a: Float64) = 1.0 / a;\nrule dist(a: Float64, b: Float64) -> Float64 = a * a + b * b;\nwire flight_range = hypotenuse;\n",
 "merge_rules": [
  "flight_range",
  "hypotenuse",
  "right_assoc",
  "ieee_zero"
 ],
