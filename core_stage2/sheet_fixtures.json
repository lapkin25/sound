{
  "sheet": "trajectory",
  "target": "dist",
  "columns": [
    {
      "name": "time",
      "role": "input",
      "type": "Float64",
      "unit": "s"
    },
    {
      "name": "half",
      "role": "const",
      "type": "Float64",
      "unit": "1",
      "value": 0.5
    },
    {
      "name": "g",
      "role": "const",
      "type": "Float64",
      "unit": "m/s^2",
      "value": 9.81
    },
    {
      "name": "dist",
      "role": "computed",
      "type": "Float64",
      "unit": "m",
      "formula": {
        "op": "*",
        "l": {
          "ref": "time"
        },
        "r": {
          "op": "*",
          "l": {
            "ref": "half"
          },
          "r": {
            "op": "*",
            "l": {
              "ref": "time"
            },
            "r": {
              "ref": "g"
            }
          }
        }
      },
      "invariant": {
        "cmp": ">=",
        "l": {
          "ref": "dist"
        },
        "r": {
          "const": 0
        }
      }
    }
  ],
  "vectors": [
    {
      "name": "j01",
      "binds": {
        "time": 45.0,
        "half": 0.5,
        "g": 9.81
      },
      "expect": {
        "hex_bits": "0x1.3665000000001p+13"
      }
    },
    {
      "name": "t2",
      "binds": {
        "time": 3.0,
        "half": 0.5,
        "g": 9.81
      },
      "expect": {
        "hex_bits": "0x1.6128f5c28f5c2p+5"
      }
    },
    {
      "name": "negzero",
      "binds": {
        "time": "8000000000000000",
        "half": 0.5,
        "g": 9.81
      },
      "expect": {
        "hex_bits": "0x0.0p+0"
      }
    },
    {
      "name": "neg-half",
      "binds": {
        "time": 45.0,
        "half": -0.5,
        "g": 9.81
      },
      "expect": {
        "err": "err DomainError dist: invariant"
      }
    },
    {
      "name": "nan",
      "binds": {
        "time": "7ff8000000000000",
        "half": 0.5,
        "g": 9.81
      },
      "expect": {
        "err": "err DomainError dist: invariant"
      }
    }
  ]
}