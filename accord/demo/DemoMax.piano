# DemoMax — максимум в массиве целых чисел
# грамматика v0.5.1 (frozen); foldlist — единственная итерация, Аккорд не нужен

fact n  = 8
fact a0 = 3
fact a1 = -1
fact a2 = 4
fact a3 = 1
fact a4 = 5
fact a5 = 9
fact a6 = 2
fact a7 = 6

fact arr8 = snoc (snoc (snoc (snoc (snoc (snoc (snoc (snoc nil a0) a1) a2) a3) a4) a5) a6) a7

rule step cur x = If (lt cur x) x cur

out m = foldlist step (part arr8 0) (tail arr8)
